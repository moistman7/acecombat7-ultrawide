struct Output {float4 tex10:TEXCOORD10;float4 tex11:TEXCOORD11;float4 uv:TEXCOORD0;float4 position:SV_Position;};
cbuffer Order:register(b0){float4 order;} // x: winding, y: perspective, z: inset, w: offscreen shift
Output main(uint id:SV_VertexID){if(order.x>0)id=id%3==1?id+1:id%3==2?id-1:id;const float2 coords[6]={float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)};Output o;o.tex10=o.tex11=0;o.uv=float4(coords[id],0,0);o.position=float4((o.uv.x*2-1)*(2560.0/3440.0),1-o.uv.y*2,0,1);if(order.z>0)o.position.xy*=order.z;if(order.y>=2)o.position*=order.y==2?90:order.y==3?64:order.y==4?72:80;else if(order.y>0)o.position.w=1+.12*(o.uv.x-.5);o.position.x+=order.w*o.position.w;return o;}
